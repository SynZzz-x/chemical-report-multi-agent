# Copy this file to .env and fill in local credentials.
# Never commit real API keys.

OPENAI_API_KEY=replace-with-your-openai-compatible-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
OPENAI_MODEL=deepseek-v3

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agent-report-demo
LANGSMITH_API_KEY=replace-with-your-langsmith-key

DASHSCOPE_API_KEY=replace-with-your-dashscope-key
