# Copy this file to .env and fill in local credentials.
# Never commit real API keys.

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agent-report-demo
LANGSMITH_API_KEY=replace-with-your-langsmith-key

# Hybrid chemical RAG through a separately deployed TEI server.
AGENT_CACHE_ROOT=./cache
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=66e95e324bebb9453d3b5be447c898dca1ba0eb0
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
RAG_CHILD_TARGET_TOKENS=450
RAG_CHILD_MAX_TOKENS=700
RAG_CHILD_OVERLAP_TOKENS=70
RAG_PARENT_TARGET_TOKENS=1200
RAG_PARENT_MAX_TOKENS=1600
RAG_BM25_TOP_K=40
RAG_DENSE_TOP_K=40
RAG_DENSE_OVERFETCH_FACTOR=3
RAG_RRF_CHILD_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_MAX_HITS_PER_PARENT=2
RAG_RRF_K=60
RAG_MAX_CONTEXT_TOKENS=5000

# Evidence-grounded conceptual diagrams. Install the Graphviz system package
# so the `dot` executable is available on PATH.
CONCEPT_GRAPH_ENABLED=true
CONCEPT_GRAPH_RENDERER=graphviz
CONCEPT_GRAPH_MAX_NODES=24
CONCEPT_GRAPH_MAX_EDGES=40
CONCEPT_GRAPH_FONT_FAMILY=Noto Sans CJK SC
EVIDENCE_RAG_MAX_QUERIES=3
EVIDENCE_RAG_ADAPTIVE_RESERVE=1
EVIDENCE_WEB_MAX_QUERIES=3
EVIDENCE_WEB_FALLBACK=true
EVIDENCE_WEB_ALLOWED_SOURCE_CLASSES=government,standards,academic,vendor

# Local persistence identity and checkpoint hardening.
AGENT_USER_ID=local-user
LANGGRAPH_STRICT_MSGPACK=true
